# Fichier : waf_git_gefa_de.tf

# ⚠️ Le bloc de migration : empêche Terraform de détruire/recréer la policy
moved {
  from = azurerm_web_application_firewall_policy.waf_policies["git.gefa.de"]
  to   = azurerm_web_application_firewall_policy.git_gefa_de
}

resource "azurerm_web_application_firewall_policy" "git_gefa_de" {
  name                = "git.gefa.de"
  resource_group_name = var.rg_name
  location            = var.location

  policy_settings {
    enabled                          = true
    mode                             = "Prevention"
    request_body_check               = true
    max_request_body_size_in_kb      = 1024
    file_upload_limit_in_mb          = 100
    request_body_inspect_limit_in_kb = 1024
  }

  # ==========================================
  # CUSTOM RULES
  # ==========================================
  custom_rules {
    name      = "AllowDocker"
    priority  = 10
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "/docker-base-images",
        "/internal-java",
        "/data-management",
        "/backoffice",
        "/graphql",
        "/asset"
      ]
    }
  }

  # ==========================================
  # MANAGED RULES (Moteurs par défaut + Exceptions Redmine)
  # ==========================================
  managed_rules {
    managed_rule_set {
      type    = "Microsoft_DefaultRuleSet"
      version = "2.1"

      # --- Exceptions pour l'application Redmine ---

      # Désactivation Protocol Enforcement
      rule_group_override {
        rule_group_name = "PROTOCOL-ENFORCEMENT"
        rule {
          id      = "920420"
          enabled = false
        }
      }

      # Désactivation Faux Positifs RCE (Code dans les tickets)
      rule_group_override {
        rule_group_name = "RCE"
        rule {
          id      = "932100"
          enabled = false
        }
        rule {
          id      = "932115"
          enabled = false
        }
        rule {
          id      = "932160"
          enabled = false
        }
      }

      # Désactivation Faux Positifs SQLi (Apostrophes/Code SQL dans les tickets)
      rule_group_override {
        rule_group_name = "SQLI"
        rule {
          id      = "942430"
          enabled = false
        }
      }
    }

    managed_rule_set {
      type    = "Microsoft_BotManagerRuleSet"
      version = "1.0"
    }
  }
}
