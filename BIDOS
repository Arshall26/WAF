AzureDiagnostics
| where Category == "ApplicationGatewayFirewallLog"
| where hostname_s == "redmine.gefa-a.de"
| where ruleGroup_s contains "Php"
| project 
    TimeGenerated,
    Action = action_s,                 
    ClientIP = clientIp_s,             
    RequestURI = requestUri_s,        
    RuleGroup = ruleGroup_s,           
    RuleID = ruleId_s,                 
    Message = Message,                 
    MatchDetails = details_message_s,  
    MatchData = details_data_s         
| sort by TimeGenerated desc

