# Fichier : waf_sgef_sgmarkets_com.tf

# ⚠️ BLOC IMPORT : Pense à vérifier l'ID de souscription
import {
  to = azurerm_web_application_firewall_policy.sgef_sgmarkets_com
  id = "/subscriptions/d12989f0-afeb-4232-bcca-9965b4570d87/resourceGroups/${var.rg_name}/providers/Microsoft.Network/applicationGatewayWebApplicationFirewallPolicies/sgef.sgmarkets.com"
}

resource "azurerm_web_application_firewall_policy" "sgef_sgmarkets_com" {
  name                = "sgef.sgmarkets.com"
  resource_group_name = var.rg_name
  location            = var.location

  policy_settings {
    enabled                          = true
    mode                             = "Prevention"
    request_body_check               = true
    max_request_body_size_in_kb      = 1024
    file_upload_limit_in_mb          = 100
    request_body_inspect_limit_in_kb = 1024
    request_body_enforcement         = true
    file_upload_enforcement          = true
  }

  # ==========================================
  # CUSTOM RULES
  # ==========================================
  custom_rules {
    name      = "blockingsubnet"
    priority  = 1
    rule_type = "MatchRule"
    action    = "Block"
    
    match_conditions {
      match_variables {
        variable_name = "RemoteAddr"
      }
      operator     = "IPMatch"
      match_values = [
        "176.117.107.101",
        "176.117.107.104",
        "198.7.56.247",
        "5.45.102.93",
        "203.2.112.183",
        "81.249.233.174",
        "86.211.98.235",
        "203.2.112.125",
        "36.111.32.237",
        "90.14.32.118",
        "20.122.40.187"
      ]
    }
  }

  custom_rules {
    name      = "cve202555182"
    priority  = 2
    rule_type = "MatchRule"
    action    = "Block"
    
    match_conditions {
      match_variables {
        variable_name = "PostArgs"
      }
      operator     = "Contains"
      match_values = [
        "constructor",
        "__proto__",
        "prototype",
        "_response"
      ]
      transforms   = ["Lowercase", "RemoveNulls", "UrlDecode"]
    }
    match_conditions {
      match_variables {
        variable_name = "RequestHeaders"
        selector      = "next-action"
      }
      operator     = "Any"
      match_values = []
    }
  }

  custom_rules {
    name      = "cve202555182ver2"
    priority  = 3
    rule_type = "MatchRule"
    action    = "Block"
    
    match_conditions {
      match_variables {
        variable_name = "PostArgs"
      }
      operator     = "Contains"
      match_values = [
        "constructor",
        "__proto__",
        "prototype",
        "_response"
      ]
      transforms   = ["Lowercase", "UrlDecode", "RemoveNulls"]
    }
    match_conditions {
      match_variables {
        variable_name = "RequestHeaders"
        selector      = "rsc-action-id"
      }
      operator     = "Any"
      match_values = []
    }
  }

  custom_rules {
    name      = "AllowApiRoot"
    priority  = 10
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "/api/p",
        "api/v"
      ]
    }
  }

  custom_rules {
    name      = "Allow"
    priority  = 11
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "/graphql"
      ]
    }
  }

  custom_rules {
    name      = "AllowToken"
    priority  = 12
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "/auth/realms/bpcees/",
        "/one-authentication-client/"
      ]
    }
  }

  # ==========================================
  # MANAGED RULES & EXCLUSIONS
  # ==========================================
  managed_rules {
    managed_rule_set {
      type    = "OWASP"
      version = "3.2"

      rule_group_override {
        rule_group_name = "General"
        
        rule {
          id      = "200004"
          enabled = false
        }
        rule {
          id      = "200003"
          enabled = false
        }
        rule {
          id      = "200002"
          enabled = true
          action  = "AnomalyScoring"
        }
      }
    }

    # --- Exclusions Globales ---
    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "Equals"
      selector                = "sgconnect-l1"
    }

    # Doublon présent dans ton export JSON (volontaire pour éviter un drift au premier plan)
    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "Equals"
      selector                = "sgconnect-l1"
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_hsr"
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_cvar"
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_ses"
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_ref"
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_id"
    }

    exclusion {
      match_variable          = "RequestArgNames"
      selector_match_operator = "Equals"
      selector                = "details"
    }
  }
}
