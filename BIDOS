resource "azurerm_web_application_firewall_policy" "waf_policies" {
  for_each            = local.waf_configs

  name                = each.key
  resource_group_name = var.rg_name
  location            = var.location

  policy_settings {
    enabled                          = true
    mode                             = each.value.mode
    request_body_check               = true
    max_request_body_size_in_kb      = 1024
    file_upload_limit_in_mb          = 100
    request_body_inspect_limit_in_kb = 1024
  }

  managed_rules {
    # MOTEUR 1 : Règles OWASP Classiques (Default Rule Set)
    managed_rule_set {
      type    = "Microsoft_DefaultRuleSet"
      version = "2.1"

      dynamic "rule_group_override" {
        for_each = each.value.drs_overrides
        
        content {
          rule_group_name = rule_group_override.key

          dynamic "rule" {
            for_each = rule_group_override.value
            content {
              id      = rule.value
              enabled = false
            }
          }
        }
      }
    }

    # MOTEUR 2 : Règles Anti-Bots (Bot Manager Rule Set)
    managed_rule_set {
      type    = "Microsoft_BotManagerRuleSet"
      version = "1.0"

      dynamic "rule_group_override" {
        for_each = each.value.bot_overrides
        
        content {
          rule_group_name = rule_group_override.key

          dynamic "rule" {
            for_each = rule_group_override.value
            content {
              id      = rule.value
              enabled = false
            }
          }
        }
      }
    }
  }
}
