  # ==========================================
  # MANAGED RULES (Moteurs par défaut + Exceptions Redmine)
  # ==========================================
  managed_rules {
    managed_rule_set {
      type    = "Microsoft_DefaultRuleSet"
      version = "2.1"

      # --- Exceptions pour l'application Redmine ---
      # Désactivation Protocol Enforcement
      rule_group_override {
        rule_group_name = "Protocol-Enforcement"
        rule {
          id      = "920420"
          enabled = false
        }
      }

      # Désactivation Faux Positifs RCE (Code dans les tickets)
      rule_group_override {
        rule_group_name = "Web-Attack-RCE"
        rule {
          id      = "932100"
          enabled = false
        }
        rule {
          id      = "932115"
          enabled = false
        }
        rule {
          id      = "932160"
          enabled = false
        }
      }

      # Désactivation Faux Positifs SQLi (Apostrophes/Code SQL dans les tickets)
      rule_group_override {
        rule_group_name = "Web-Attack-SQLI"
        rule {
          id      = "942430"
          enabled = false
        }
      }
    }

    managed_rule_set {
      type    = "Microsoft_BotManagerRuleSet"
      version = "1.0"
      # Aucune règle Bot désactivée sur cet environnement
    }
  }
