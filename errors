# Fichier : waf_smartbalancesheet_hml_sgmarkets.tf

# ⚠️ BLOC IMPORT avec la souscription en dur et le RG en variable
import {
  to = azurerm_web_application_firewall_policy.smartbalancesheet_hml_sgmarkets_com
  id = "/subscriptions/d12989f0-afeb-4232-bcca-9965b4570d87/resourceGroups/${var.rg_name}/providers/Microsoft.Network/applicationGatewayWebApplicationFirewallPolicies/smartbalancesheet-hml.sgmarkets.com"
}

resource "azurerm_web_application_firewall_policy" "smartbalancesheet_hml_sgmarkets_com" {
  name                = "smartbalancesheet-hml.sgmarkets.com"
  resource_group_name = var.rg_name
  location            = var.location

  policy_settings {
    enabled                          = true
    mode                             = "Prevention" # Repris de ton export
    request_body_check               = true
    max_request_body_size_in_kb      = 1024
    file_upload_limit_in_mb          = 100
    request_body_inspect_limit_in_kb = 1024
  }

  # ==========================================
  # CUSTOM RULES (3 Règles)
  # ==========================================
  custom_rules {
    name      = "AllowAPI"
    priority  = 10
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "api/v",
        "/api/p"
      ]
    }
  }

  custom_rules {
    name      = "Allow"
    priority  = 11
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "/graphql"
      ]
    }
  }

  custom_rules {
    name      = "AllowToken"
    priority  = 12
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "/one-authentication-client/",
        "/auth/realms/bpcees/"
      ]
    }
  }

  # ==========================================
  # MANAGED RULES (3 Moteurs par défaut)
  # ==========================================
  managed_rules {
    managed_rule_set {
      type    = "Microsoft_DefaultRuleSet"
      version = "2.2"
    }

    managed_rule_set {
      type    = "Microsoft_BotManagerRuleSet"
      version = "1.1"
    }

    managed_rule_set {
      type    = "Microsoft_HTTPDDoSRuleSet"
      version = "1.0"
    }
  }
}
