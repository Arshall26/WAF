# Fichier : waf_gefa_connect_gefa_a_de.tf

# ⚠️ Le bloc de migration : empêche Terraform de détruire/recréer la policy
moved {
  from = azurerm_web_application_firewall_policy.waf_policies["gefa-connect.gefa-a.de"]
  to   = azurerm_web_application_firewall_policy.gefa_connect_gefa_a_de
}

resource "azurerm_web_application_firewall_policy" "gefa_connect_gefa_a_de" {
  name                = "gefa-connect.gefa-a.de"
  resource_group_name = var.rg_name
  location            = var.location

  policy_settings {
    enabled                          = true
    mode                             = "Prevention" # Repris de ton export JSON
    request_body_check               = true
    max_request_body_size_in_kb      = 1024
    file_upload_limit_in_mb          = 100
    request_body_inspect_limit_in_kb = 1024
  }

  # ==========================================
  # CUSTOM RULES (Issues du portail)
  # ==========================================
  custom_rules {
    name      = "Allow"
    priority  = 10
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "/HTML/router.jsp"
      ]
    }
  }

  # ==========================================
  # MANAGED RULES (Moteurs par défaut)
  # ==========================================
  managed_rules {
    managed_rule_set {
      type    = "Microsoft_DefaultRuleSet"
      version = "2.1"
      # Aucune exclusion OWASP sur cet environnement
    }

    managed_rule_set {
      type    = "Microsoft_BotManagerRuleSet"
      version = "1.0"
      # Aucune règle Bot désactivée sur cet environnement
    }
  }
}
