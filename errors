{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "ApplicationGatewayWebApplicationFirewallPolicies_smartbalancesheet_hml_sgmarkets_com_name": {
            "defaultValue": "smartbalancesheet-hml.sgmarkets.com",
            "type": "String"
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.Network/ApplicationGatewayWebApplicationFirewallPolicies",
            "apiVersion": "2025-07-01",
            "name": "[parameters('ApplicationGatewayWebApplicationFirewallPolicies_smartbalancesheet_hml_sgmarkets_com_name')]",
            "location": "northeurope",
            "properties": {
                "customRules": [
                    {
                        "name": "AllowAPI",
                        "priority": 10,
                        "ruleType": "MatchRule",
                        "action": "Allow",
                        "matchConditions": [
                            {
                                "matchVariables": [
                                    {
                                        "variableName": "RequestUri"
                                    }
                                ],
                                "operator": "Contains",
                                "negationConditon": false,
                                "matchValues": [
                                    "api/v",
                                    "/api/p"
                                ],
                                "transforms": []
                            }
                        ],
                        "state": "Enabled"
                    },
                    {
                        "name": "Allow",
                        "priority": 11,
                        "ruleType": "MatchRule",
                        "action": "Allow",
                        "matchConditions": [
                            {
                                "matchVariables": [
                                    {
                                        "variableName": "RequestUri"
                                    }
                                ],
                                "operator": "Contains",
                                "negationConditon": false,
                                "matchValues": [
                                    "/graphql"
                                ],
                                "transforms": []
                            }
                        ],
                        "state": "Enabled"
                    },
                    {
                        "name": "AllowToken",
                        "priority": 12,
                        "ruleType": "MatchRule",
                        "action": "Allow",
                        "matchConditions": [
                            {
                                "matchVariables": [
                                    {
                                        "variableName": "RequestUri"
                                    }
                                ],
                                "operator": "Contains",
                                "negationConditon": false,
                                "matchValues": [
                                    "/one-authentication-client/",
                                    "/auth/realms/bpcees/"
                                ],
                                "transforms": []
                            }
                        ],
                        "state": "Enabled"
                    }
                ],
                "policySettings": {
                    "requestBodyCheck": true,
                    "maxRequestBodySizeInKb": 1024,
                    "fileUploadLimitInMb": 100,
                    "state": "Enabled",
                    "mode": "Prevention",
                    "jsChallengeCookieExpirationInMins": 30,
                    "requestBodyInspectLimitInKB": 1024,
                    "fileUploadEnforcement": true,
                    "requestBodyEnforcement": true
                },
                "managedRules": {
                    "managedRuleSets": [
                        {
                            "ruleSetType": "Microsoft_DefaultRuleSet",
                            "ruleSetVersion": "2.2",
                            "ruleGroupOverrides": []
                        },
                        {
                            "ruleSetType": "Microsoft_BotManagerRuleSet",
                            "ruleSetVersion": "1.1",
                            "ruleGroupOverrides": []
                        },
                        {
                            "ruleSetType": "Microsoft_HTTPDDoSRuleSet",
                            "ruleSetVersion": "1.0",
                            "ruleGroupOverrides": []
                        }
                    ],
                    "exclusions": []
                }
            }
        }
    ]
}
