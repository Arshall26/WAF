# ==========================================
  # CUSTOM RULES : Virtual Patching PHP2Shell (CVE-2026-109618 / 109619)
  # ==========================================
  custom_rules {
    name      = "BlockPhpSessionUploadProgress"
    priority  = 90
    rule_type = "MatchRule"
    action    = "Block"
    
    # Condition 1 : Vérifie si le header Content-Type contient multipart/form-data
    match_conditions {
      match_variables {
        variable_name = "RequestHeaders"
        selector      = "Content-Type"
      }
      operator           = "Contains"
      negation_condition = false
      match_values       = [
        "multipart/form-data"
      ]
      transforms         = ["Lowercase"]
    }

    # Condition 2 : Vérifie si les arguments POST contiennent php_session_upload_progress
    match_conditions {
      match_variables {
        variable_name = "PostArgs"
      }
      operator           = "Contains"
      negation_condition = false
      match_values       = [
        "php_session_upload_progress"
      ]
      transforms         = ["Lowercase"]
    }
  }
