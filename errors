AzureDiagnostics
| where Category == "ApplicationGatewayFirewallLog"
| where hostname_s == "sgef.sgmarkets.com"
| project 
    TimeGenerated,
    Action = action_s,                 // "Matched" ou "Blocked"
    ClientIP = clientIp_s,             // L'IP de l'attaquant ou du client
    RequestURI = requestUri_s,         // L'URL exacte tapée après le .com
    RuleGroup = ruleGroup_s,           // La famille de la règle (ex: BotManager, SQLi)
    RuleID = ruleId_s,                 // L'ID de la règle (ex: 920320, 300700)
    Message = Message,                 // La description du blocage
    MatchDetails = details_message_s,  // Le nom du paramètre en cause (ex: Cookie, Header)
    MatchData = details_data_s         // La valeur exacte du paramètre
| sort by TimeGenerated desc
