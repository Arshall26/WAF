# =============================================================================
# Script      : Export-OpenCostFinOps-XLSX.ps1
# Description : Parse un export JSON OpenCost, extrait les métriques FinOps, 
#               arrondit les coûts, et génère un vrai fichier Excel (.xlsx) formatté.
# Prérequis   : Install-Module -Name ImportExcel
# =============================================================================

$jsonFilePath = "compute.json"
$xlsxFilePath = "OpenCost_Export.xlsx" # Changement de l'extension ici

if (-not (Test-Path -Path $jsonFilePath)) {
    Write-Error "Le fichier $jsonFilePath est introuvable."
    exit
}

Write-Host "Lecture du fichier $jsonFilePath..." -ForegroundColor Cyan

# 1. Lecture et parsing du JSON
$json = Get-Content -Path $jsonFilePath -Raw | ConvertFrom-Json
$data = $json.data

$items = @()
if ($data -is [array] -and $data.Count -eq 1 -and $data[0].GetType().Name -eq "PSCustomObject") {
    $items = $data[0].psobject.properties.Value
} elseif ($data.GetType().Name -eq "PSCustomObject") {
    $items = $data.psobject.properties.Value
} else {
    $items = $data
}

# 2. Extraction et arrondi (on garde le type [double] pour Excel)
$processedItems = foreach ($item in $items) {
    if (-not [string]::IsNullOrWhiteSpace($item.name)) {
        [PSCustomObject]@{
            Name             = $item.name
            Cluster          = $item.properties.cluster
            CpuCost          = [Math]::Round([double]$item.cpuCost, 2)
            RamCost          = [Math]::Round([double]$item.ramCost, 2)
            PvCost           = [Math]::Round([double]$item.pvCost, 2)
            NetworkCost      = [Math]::Round([double]$item.networkCost, 2)
            LoadBalancerCost = [Math]::Round([double]$item.loadBalancerCost, 2)
            SharedCost       = [Math]::Round([double]$item.sharedCost, 2)
            TotalCost        = [Math]::Round([double]$item.totalCost, 2)
        }
    }
}

# 3. Tri par TotalCost descendant
$sortedItems = $processedItems | Sort-Object TotalCost -Descending

# 4. Génération du fichier Excel (.xlsx)
# Si le fichier existe déjà, il sera écrasé proprement
Write-Host "Création du fichier Excel..." -ForegroundColor Cyan

$sortedItems | Export-Excel -Path $xlsxFilePath -WorksheetName "FinOps OpenCost" `
    -ClearSheet `
    -AutoSize `
    -FreezeTopRow `
    -BoldTopRow `
    -TableName "DonneesFinOps" `
    -TableStyle Medium2 `
    -NumberFormat "#,##0.00 €"

Write-Host "`nAperçu des plus gros consommateurs (Top 5) :" -ForegroundColor Yellow
$sortedItems | Select-Object Name, Cluster, CpuCost, RamCost, PvCost, TotalCost | Select-Object -First 5 | Format-Table -AutoSize

Write-Host "Export Excel terminé avec succès !" -ForegroundColor Green
Write-Host "Fichier généré : $(Resolve-Path $xlsxFilePath)" -ForegroundColor Green
