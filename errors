# Fichier : waf_smartbalancesheet_sgmarkets.tf

# ⚠️ BLOC IMPORT avec la souscription en dur et le RG en variable
import {
  to = azurerm_web_application_firewall_policy.smartbalancesheet_sgmarkets_com
  id = "/subscriptions/d12989f0-afeb-4232-bcca-9965b4570d87/resourceGroups/${var.rg_name}/providers/Microsoft.Network/applicationGatewayWebApplicationFirewallPolicies/smartbalancesheet.sgmarkets.com"
}

resource "azurerm_web_application_firewall_policy" "smartbalancesheet_sgmarkets_com" {
  name                = "smartbalancesheet.sgmarkets.com"
  resource_group_name = var.rg_name
  location            = var.location

  policy_settings {
    enabled                          = true
    mode                             = "Prevention" # Repris de ton export
    request_body_check               = true
    max_request_body_size_in_kb      = 1024
    file_upload_limit_in_mb          = 100
    request_body_inspect_limit_in_kb = 1024
  }

  # ==========================================
  # CUSTOM RULES (3 Règles)
  # ==========================================
  custom_rules {
    name      = "AllowAPI"
    priority  = 10
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "api/v",
        "/api/p"
      ]
    }
  }

  custom_rules {
    name      = "Allow"
    priority  = 11
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "/graphql"
      ]
    }
  }

  custom_rules {
    name      = "AllowToken"
    priority  = 12
    rule_type = "MatchRule"
    action    = "Allow"
    
    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      operator     = "Contains"
      match_values = [
        "/one-authentication-client/",
        "/auth/realms/bpcees/"
      ]
    }
  }

  # ==========================================
  # MANAGED RULES & EXCLUSIONS
  # ==========================================
  managed_rules {

    # --- Exclusions Globales (Cookies) ---
    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "Equals"
      selector                = "sgconnect-l1"
    }
    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "Equals"
      selector                = "sgconnect-l2"
    }
    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_cvar"
    }
    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_hsr"
    }
    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_id"
    }
    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_ref"
    }
    exclusion {
      match_variable          = "RequestCookieNames"
      selector_match_operator = "StartsWith"
      selector                = "_pk_ses"
    }

    # --- OWASP 3.2 ---
    managed_rule_set {
      type    = "OWASP"
      version = "3.2"

      rule_group_override {
        rule_group_name = "General"
        rule {
          id      = "200004"
          enabled = false
          action  = "AnomalyScoring"
        }
      }

      rule_group_override {
        rule_group_name = "REQUEST-932-APPLICATION-ATTACK-RCE"
        rule {
          id      = "932100"
          enabled = false
          action  = "AnomalyScoring"
        }
        rule {
          id      = "932110"
          enabled = false
          action  = "AnomalyScoring"
        }
      }

      rule_group_override {
        rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        rule {
          id      = "942430"
          enabled = false
          action  = "AnomalyScoring"
        }
      }
    }

    # --- Bot Manager 1.1 ---
    managed_rule_set {
      type    = "Microsoft_BotManagerRuleSet"
      version = "1.1"

      rule_group_override {
        rule_group_name = "BadBots"
        rule {
          id      = "100100"
          enabled = false
          action  = "Block"
        }
        rule {
          id      = "100200"
          enabled = false
          action  = "Block"
        }
        rule {
          id      = "100300"
          enabled = false
          action  = "Block"
        }
      }

      rule_group_override {
        rule_group_name = "GoodBots"
        rule {
          id      = "200100"
          enabled = false
          action  = "Allow"
        }
        rule {
          id      = "200200"
          enabled = false
          action  = "Allow"
        }
        rule {
          id      = "200300"
          enabled = false
          action  = "Allow"
        }
        rule {
          id      = "200400"
          enabled = false
          action  = "Allow"
        }
        rule {
          id      = "200500"
          enabled = false
          action  = "Allow"
        }
        rule {
          id      = "200600"
          enabled = false
          action  = "Allow"
        }
        rule {
          id      = "200700"
          enabled = false
          action  = "Allow"
        }
      }

      rule_group_override {
        rule_group_name = "UnknownBots"
        rule {
          id      = "300100"
          enabled = false
          action  = "Log"
        }
        rule {
          id      = "300200"
          enabled = false
          action  = "Log"
        }
        rule {
          id      = "300300"
          enabled = false
          action  = "Log"
        }
        rule {
          id      = "300400"
          enabled = false
          action  = "Log"
        }
        rule {
          id      = "300500"
          enabled = false
          action  = "Log"
        }
        rule {
          id      = "300600"
          enabled = false
          action  = "Log"
        }
        rule {
          id      = "300700"
          enabled = false
          action  = "Log"
        }
      }
    }
  }
}
