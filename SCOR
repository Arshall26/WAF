param(
    [object]$RecoveryPlanContext
)

$ErrorActionPreference = "Continue"
Write-Output "========================================================="
Write-Output "=== ASR FinOps Smart Tiering Runbook (Time-Based) ==="
Write-Output "========================================================="

$TargetSku = "Premium_LRS"
# On cherche les disques créés dans les 60 dernières minutes (UTC pour coller aux logs Azure)
$TimeThreshold = (Get-Date).ToUniversalTime().AddMinutes(-60)

Write-Output "-> Connecting to Azure..."
Disable-AzContextAutosave -Scope Process | Out-Null
Connect-AzAccount -Identity | Out-Null

$vmNodes = $RecoveryPlanContext.VmMap.PSObject.Properties.Value

foreach ($node in $vmNodes) {
    $targetSubId = $node.SubscriptionId
    $targetRgName = $node.ResourceGroupName

    if ([string]::IsNullOrWhiteSpace($targetRgName)) {
        continue
    }

    Write-Output "------------------------------------------------"
    Write-Output "-> Target RG: $targetRgName"
    Set-AzContext -SubscriptionId $targetSubId | Out-Null

    $allVms = Get-AzVM -ResourceGroupName $targetRgName
    
    if ($null -eq $allVms) {
        Write-Output "No VMs found in Resource Group. Skip."
        continue
    }

    # 1. Détection dynamique de la VM de Failover basée sur l'heure de création du disque
    $targetVms = @()
    foreach ($vm in @($allVms)) {
        if ($null -ne $vm.StorageProfile.OsDisk.ManagedDisk.Id) {
            $osDiskId = $vm.StorageProfile.OsDisk.ManagedDisk.Id
            $diskParts = $osDiskId -split "/"
            $diskRg = $diskParts[4]
            $diskName = $diskParts[8]
            
            $osDisk = Get-AzDisk -ResourceGroupName $diskRg -DiskName $diskName
            
            if ($osDisk.TimeCreated -ge $TimeThreshold) {
                Write-Output ">>> FRESH VM DETECTED: $($vm.Name) (Disk created at $($osDisk.TimeCreated))"
                $targetVms += $vm
            } else {
                Write-Output "    [Ignored Old VM]: $($vm.Name) (Disk created at $($osDisk.TimeCreated))"
            }
        }
    }

    if ($targetVms.Count -eq 0) {
        Write-Output "No newly created VMs found in the last 60 minutes. Ending process."
        continue
    }

    # 2. Traitement des VMs récentes (Stop -> Update -> Start)
    foreach ($vm in $targetVms) {
        $vmName = $vm.Name
        Write-Output ">>> Processing VM: $vmName"
        
        $diskIds = @()
        if ($null -ne $vm.StorageProfile.OsDisk.ManagedDisk.Id) { $diskIds += $vm.StorageProfile.OsDisk.ManagedDisk.Id }
        foreach ($dataDisk in $vm.StorageProfile.DataDisks) {
            if ($null -ne $dataDisk.ManagedDisk.Id) { $diskIds += $dataDisk.ManagedDisk.Id }
        }

        $disksToUpdate = @()
        foreach ($diskId in $diskIds) {
            $diskParts = $diskId -split "/"
            $diskRg = $diskParts[4]
            $diskName = $diskParts[8]
            
            $disk = Get-AzDisk -ResourceGroupName $diskRg -DiskName $diskName
            if ($disk.Sku.Name -ne $TargetSku) {
                $disksToUpdate += $disk
            }
        }

        if ($disksToUpdate.Count -eq 0) {
            Write-Output "    All disks are already $TargetSku. Skipping restart."
            continue
        }

        Write-Output "    Stopping VM '$vmName' for disk conversion..."
        Stop-AzVM -ResourceGroupName $targetRgName -Name $vmName -Force -NoWait:$false | Out-Null
        Write-Output "    VM stopped."

        foreach ($disk in $disksToUpdate) {
            Write-Output "    Converting disk $($disk.Name) to $TargetSku..."
            $diskUpdateConfig = New-AzDiskUpdateConfig -SkuName $TargetSku
            Update-AzDisk -ResourceGroupName $disk.ResourceGroupName -DiskName $disk.Name -DiskUpdate $diskUpdateConfig | Out-Null
        }

        Write-Output "    Starting VM '$vmName'..."
        Start-AzVM -ResourceGroupName $targetRgName -Name $vmName -NoWait:$false | Out-Null
        Write-Output "    VM '$vmName' restarted with Premium SSDs!"
    }
}

Write-Output "========================================================="
Write-Output "=== END OF SCRIPT ==="
Write-Output "========================================================="
