# Collect les metrique de OS et disk write byte per second sur toutes les vms de prod (verifier et/ou modifier les subscriptions à parcourir si besoin) et en sortie un .csv
param(
    [string]$NamePattern = 'PRD',

    # Subscriptions à parcourir
    [string[]]$SubscriptionIds = @(
        "dd640247-c8a0-4d39-9444-bb13c6f3c417", # SCOR-Gold-Prd-Core
        "7d9c4572-aacb-4974-b90c-9cb43c1579f9", # SCOR-Gold-Prd-CRO
        "75d2b152-7638-4cff-a4cf-5c86eaef3e89", # SCOR-Gold-Prd-SGI
        "4a898a92-83ea-4b19-82bd-ce6673d35900", # SCOR-Gold-Prd-SGL
        "327d24cf-e658-41c1-9af9-318687756ba4"  # SOLEM-Prod
    ),

    # Namespace métriques VM (on tente avec, puis fallback sans si besoin)
    [string]$MetricNamespace = "Microsoft.Compute/virtualMachines",

    # Exports
    [string]$CsvSemicolonPath = "./PRD_VM_Metrics_AllSubs_semicolon.csv",
    [string]$CsvCommaPath     = "./PRD_VM_Metrics_AllSubs_comma.csv"
)

# Fenêtres temporelles
$endDate   = Get-Date
$start24h  = $endDate.AddDays(-1)
$start48h  = $endDate.AddDays(-2)
$start7d   = $endDate.AddDays(-7)

function Get-TimeGrain([datetime]$start, [datetime]$end) {
    $days = ($end - $start).TotalDays
    if ($days -gt 2) { return :FromHours(1) }   # 7j -> 1h
    return :FromMinutes(5)                      # 24/48h -> 5min
}

function Get-AvgMetricTotal {
    param(
        [Parameter(Mandatory)][string]$ResourceId,
        [Parameter(Mandatory)][string]$MetricName,
        [Parameter(Mandatory)][datetime]$StartTime,
        [Parameter(Mandatory)][datetime]$EndTime,
        [string]$MetricNamespace
    )

    $tg = Get-TimeGrain -start $StartTime -end $EndTime
    $m = $null

    # 1) Essai AVEC MetricNamespace (quand disponible)
    try {
        if ($MetricNamespace -and $MetricNamespace.Trim().Length -gt 0) {
            $m = Get-AzMetric -ResourceId $ResourceId `
                              -MetricName $MetricName `
                              -AggregationType Average `
                              -StartTime $StartTime -EndTime $EndTime `
                              -TimeGrain $tg `
                              -MetricNamespace $MetricNamespace `
                              -DetailedOutput `
                              -ErrorAction Stop
        }
        else {
            throw "MetricNamespace vide"
        }
    }
    catch {
        # 2) Fallback : essai SANS MetricNamespace (souvent plus tolérant)
        try {
            $m = Get-AzMetric -ResourceId $ResourceId `
                              -MetricName $MetricName `
                              -AggregationType Average `
                              -StartTime $StartTime -EndTime $EndTime `
                              -TimeGrain $tg `
                              -DetailedOutput `
                              -ErrorAction Stop
        }
        catch {
            Write-Warning "Métrique indisponible ($MetricName) sur $ResourceId : $($_.Exception.Message)"
            return 0
        }
    }

    if (-not $m -or -not $m.Timeseries) { return 0 }

    # Multi-timeseries : moyenne par série puis somme (utile si plusieurs data disks)
    $seriesAvgs = @(
        foreach ($ts in $m.Timeseries) {
            ($ts.Data | Measure-Object -Property Average -Average).Average
        }
    ) | Where-Object { $_ -ne $null }

    if (-not $seriesAvgs -or $seriesAvgs.Count -eq 0) { return 0 }

    $total = ($seriesAvgs | Measure-Object -Sum).Sum
    return :Round($total, 2)
}

$allResults = @()

foreach ($subId in $SubscriptionIds) {
    try {
        # Changer le contexte de subscription
        Set-AzContext -Subscription $subId -ErrorAction Stop | Out-Null  # recommandé pour basculer de subscription [2](https://learn.microsoft.com/en-us/azure/cloud-shell/get-started/classic)

        $ctx = Get-AzContext
        $subName   = $ctx.Subscription.Name
        $subRealId = $ctx.Subscription.Id

        Write-Host "==== Subscription : $subName ($subRealId) ===="

        $vms = Get-AzVM -ErrorAction Stop | Where-Object { $_.Name -match $NamePattern }
        Write-Host "VMs trouvées (pattern '$NamePattern') : $($vms.Count)"

        foreach ($vm in $vms) {
            Write-Host "Extraction des métriques pour la VM : $($vm.Name)..."

            $osAvg24h   = Get-AvgMetricTotal -ResourceId $vm.Id -MetricName "OS Disk Write Bytes/sec"   -StartTime $start24h -EndTime $endDate -MetricNamespace $MetricNamespace
            $osAvg48h   = Get-AvgMetricTotal -ResourceId $vm.Id -MetricName "OS Disk Write Bytes/sec"   -StartTime $start48h -EndTime $endDate -MetricNamespace $MetricNamespace
            $osAvg7d    = Get-AvgMetricTotal -ResourceId $vm.Id -MetricName "OS Disk Write Bytes/sec"   -StartTime $start7d  -EndTime $endDate -MetricNamespace $MetricNamespace

            $dataAvg24h = Get-AvgMetricTotal -ResourceId $vm.Id -MetricName "Data Disk Write Bytes/sec" -StartTime $start24h -EndTime $endDate -MetricNamespace $MetricNamespace
            $dataAvg48h = Get-AvgMetricTotal -ResourceId $vm.Id -MetricName "Data Disk Write Bytes/sec" -StartTime $start48h -EndTime $endDate -MetricNamespace $MetricNamespace
            $dataAvg7d  = Get-AvgMetricTotal -ResourceId $vm.Id -MetricName "Data Disk Write Bytes/sec" -StartTime $start7d  -EndTime $endDate -MetricNamespace $MetricNamespace

            $allResults += [pscustomobject]@{
                SubscriptionName         = $subName
                SubscriptionId           = $subRealId
                ResourceGroup            = $vm.ResourceGroupName
                Location                 = $vm.Location
                VMName                   = $vm.Name
                OS_Write_Bytes_Sec_24h   = $osAvg24h
                OS_Write_Bytes_Sec_48h   = $osAvg48h
                OS_Write_Bytes_Sec_7d    = $osAvg7d
                Data_Write_Bytes_Sec_24h = $dataAvg24h
                Data_Write_Bytes_Sec_48h = $dataAvg48h
                Data_Write_Bytes_Sec_7d  = $dataAvg7d
            }
        }
    }
    catch {
        Write-Warning "Impossible de traiter la subscription $subId : $($_.Exception.Message)"
        continue
    }
}

# Ordonner les colonnes
$allResults = $allResults | Select-Object `
    SubscriptionName, SubscriptionId, ResourceGroup, Location, VMName, `
    OS_Write_Bytes_Sec_24h, OS_Write_Bytes_Sec_48h, OS_Write_Bytes_Sec_7d, `
    Data_Write_Bytes_Sec_24h, Data_Write_Bytes_Sec_48h, Data_Write_Bytes_Sec_7d

# Export CSV (UTF8 BOM pour Excel)
$allResults | Export-Csv -Path $CsvSemicolonPath -NoTypeInformation -Delimiter ";" -Encoding utf8BOM  # Export-Csv: delimiter/encoding [3](https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.utility/export-csv?view=powershell-7.6)
$allResults | Export-Csv -Path $CsvCommaPath     -NoTypeInformation -Delimiter "," -Encoding utf8BOM  # Export-Csv: delimiter/encoding [3](https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.utility/export-csv?view=powershell-7.6)

Write-Host "Terminé !"
Write-Host "CSV (;) : $CsvSemicolonPath"
Write-Host "CSV (,) : $CsvCommaPath"
Write-Host "Lignes exportées : $($allResults.Count)"


