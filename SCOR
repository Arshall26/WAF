param(
    [object]$RecoveryPlanContext
)

$ErrorActionPreference = "Continue"
Write-Output "========================================================="
Write-Output "=== ASR FinOps Smart Tiering Runbook (Failback to HDD) ==="
Write-Output "========================================================="

$TargetSku = "Standard_LRS"

Write-Output "-> Connecting to Azure..."
Disable-AzContextAutosave -Scope Process | Out-Null
Connect-AzAccount -Identity | Out-Null

$vmNodes = $RecoveryPlanContext.VmMap.PSObject.Properties.Value

foreach ($node in $vmNodes) {
    $targetSubId = $node.SubscriptionId
    $targetRgName = $node.ResourceGroupName

    if ([string]::IsNullOrWhiteSpace($targetRgName)) {
        continue
    }

    Write-Output "------------------------------------------------"
    Write-Output "-> Target RG: $targetRgName"
    
    # Sécurité 1 : Exécution exclusive sur les RG de DR (se terminant par -asr)
    if ($targetRgName -notmatch "-asr$") {
        Write-Output "    [Skip] Resource Group does not end with '-asr'. Skipping downgrade."
        continue
    }

    Set-AzContext -SubscriptionId $targetSubId | Out-Null

    # Sécurité 2 : Ciblage exclusif des disques passifs ASR
    $replicaDisks = Get-AzDisk -ResourceGroupName $targetRgName | Where-Object { $_.Name -like "*-ASRReplica" }
    
    if ($null -eq $replicaDisks -or $replicaDisks.Count -eq 0) {
        Write-Output "    [Skip] No disks ending with '-ASRReplica' found."
        continue
    }

    foreach ($disk in $replicaDisks) {
        if ($disk.Sku.Name -ne $TargetSku) {
            Write-Output "    Converting replica disk $($disk.Name) to $TargetSku..."
            
            # Révocation du verrou SAS si ASR a déjà commencé la synchronisation
            if ($disk.DiskState -eq "ActiveSAS") {
                Write-Output "    Revoking active SAS lock on $($disk.Name)..."
                Revoke-AzDiskAccess -ResourceGroupName $targetRgName -DiskName $disk.Name | Out-Null
                Start-Sleep -Seconds 10
            }

            $diskUpdateConfig = New-AzDiskUpdateConfig -SkuName $TargetSku
            Update-AzDisk -ResourceGroupName $targetRgName -DiskName $disk.Name -DiskUpdate $diskUpdateConfig | Out-Null
            Write-Output "    Disk $($disk.Name) successfully downgraded to Standard HDD."
        } else {
            Write-Output "    Disk $($disk.Name) is already $TargetSku."
        }
    }
}

Write-Output "========================================================="
Write-Output "=== END OF SCRIPT ==="
Write-Output "========================================================="
