param(
    [Parameter(Mandatory=$false)]
    [string]$TargetResourceGroup = ""
)

$ErrorActionPreference = "Continue"
Write-Output "========================================================="
Write-Output "=== ASR FinOps Smart Tiering - Manual Failback to HDD ==="
Write-Output "========================================================="

$TargetSku = "Standard_LRS"

Write-Output "-> Connecting to Azure..."
Disable-AzContextAutosave -Scope Process | Out-Null
Connect-AzAccount -Identity | Out-Null

# Détermination des RGs à cibler
$rgsToProcess = @()

if ([string]::IsNullOrWhiteSpace($TargetResourceGroup)) {
    Write-Output "-> No specific Resource Group provided. Scanning subscription for DR Resource Groups (*-asr)..."
    $rgsToProcess = Get-AzResourceGroup | Where-Object { $_.ResourceGroupName -match "-asr$" }
} else {
    Write-Output "-> Targeted execution on Resource Group: $TargetResourceGroup"
    $rgsToProcess = Get-AzResourceGroup -Name $TargetResourceGroup -ErrorAction SilentlyContinue
}

if ($null -eq $rgsToProcess -or $rgsToProcess.Count -eq 0) {
    Write-Output "    [Skip] No valid Resource Groups found ending with '-asr'. Exiting."
    exit
}

foreach ($rg in $rgsToProcess) {
    $rgName = $rg.ResourceGroupName
    Write-Output "------------------------------------------------"
    Write-Output "-> Processing Target RG: $rgName"
    
    # Sécurité absolue : Ciblage exclusif des disques passifs ASR non attachés
    $replicaDisks = Get-AzDisk -ResourceGroupName $rgName | Where-Object { $_.Name -like "*-ASRReplica" -and $_.DiskState -ne "Attached" }
    
    if ($null -eq $replicaDisks -or $replicaDisks.Count -eq 0) {
        Write-Output "    [Skip] No passive ASR replica disks found in $rgName."
        continue
    }

    foreach ($disk in $replicaDisks) {
        if ($disk.Sku.Name -ne $TargetSku) {
            Write-Output "    Converting replica disk $($disk.Name) to $TargetSku..."
            
            # Révocation du verrou SAS si ASR a déjà commencé la synchronisation
            if ($disk.DiskState -eq "ActiveSAS") {
                Write-Output "    Revoking active SAS lock on $($disk.Name)..."
                Revoke-AzDiskAccess -ResourceGroupName $rgName -DiskName $disk.Name | Out-Null
                Start-Sleep -Seconds 10
            }

            $diskUpdateConfig = New-AzDiskUpdateConfig -SkuName $TargetSku
            Update-AzDisk -ResourceGroupName $rgName -DiskName $disk.Name -DiskUpdate $diskUpdateConfig | Out-Null
            Write-Output "    Disk $($disk.Name) successfully downgraded to Standard HDD."
        } else {
            Write-Output "    Disk $($disk.Name) is already $TargetSku."
        }
    }
}

Write-Output "========================================================="
Write-Output "=== END OF SCRIPT ==="
Write-Output "========================================================="
