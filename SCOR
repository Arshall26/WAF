# Collecte les métriques OS et Data Disk Write (converties en Mo/s) sur toutes les VMs de prod et exporte en .csv
param(
    [string]$NamePattern = 'PRD',

    # Subscriptions à parcourir
    [string[]]$SubscriptionIds = @(
        "dd640247-c8a0-4d39-9444-bb13c6f3c417", # SCOR-Gold-Prd-Core
        "7d9c4572-aacb-4974-b90c-9cb43c1579f9", # SCOR-Gold-Prd-CRO
        "75d2b152-7638-4cff-a4cf-5c86eaef3e89", # SCOR-Gold-Prd-SGI
        "4a898a92-83ea-4b19-82bd-ce6673d35900", # SCOR-Gold-Prd-SGL
        "327d24cf-e658-41c1-9af9-318687756ba4"  # SOLEM-Prod
    ),

    # Namespace métriques VM (on tente avec, puis fallback sans si besoin)
    [string]$MetricNamespace = "Microsoft.Compute/virtualMachines",

    # Exports
    [string]$CsvSemicolonPath = "./PRD_VM_Metrics_AllSubs_semicolon.csv",
    [string]$CsvCommaPath     = "./PRD_VM_Metrics_AllSubs_comma.csv"
)

# Fenêtres temporelles
$endDate  = Get-Date
$start24h = $endDate.AddDays(-1)
$start48h = $endDate.AddDays(-2)
$start7d  = $endDate.AddDays(-7)

function Get-TimeGrain([datetime]$start, [datetime]$end) {
    $days = ($end - $start).TotalDays
    if ($days -gt 2) { return [TimeSpan]::FromHours(1) }   # 7j -> 1h
    return [TimeSpan]::FromMinutes(5)                      # 24/48h -> 5min
}

function Get-AvgMetricTotalMBps {
    param(
        [Parameter(Mandatory)][string]$ResourceId,
        [Parameter(Mandatory)][string]$MetricName,
        [Parameter(Mandatory)][datetime]$StartTime,
        [Parameter(Mandatory)][datetime]$EndTime,
        [string]$MetricNamespace
    )

    $tg = Get-TimeGrain -start $StartTime -end $EndTime
    $m = $null

    # 1) Essai AVEC MetricNamespace (On coupe les warnings d'Azure PS avec WarningAction SilentlyContinue)
    try {
        if ($MetricNamespace -and $MetricNamespace.Trim().Length -gt 0) {
            $m = Get-AzMetric -ResourceId $ResourceId `
                              -MetricName $MetricName `
                              -AggregationType Average `
                              -StartTime $StartTime -EndTime$EndTime `
                              -TimeGrain $tg `
                              -MetricNamespace $MetricNamespace `
                              -DetailedOutput `
                              -WarningAction SilentlyContinue `
                              -ErrorAction Stop
        }
        else {
            throw "MetricNamespace vide"
        }
    }
    catch {
        # 2) Fallback : essai SANS MetricNamespace
        try {
            $m = Get-AzMetric -ResourceId $ResourceId `
                              -MetricName $MetricName `
                              -AggregationType Average `
                              -StartTime $StartTime -EndTime$EndTime `
                              -TimeGrain $tg `
                              -DetailedOutput `
                              -WarningAction SilentlyContinue `
                              -ErrorAction Stop
        }
        catch {
            Write-Warning "Métrique indisponible ($MetricName) sur$ResourceId : $($_.Exception.Message)"
            return 0
        }
    }

    if (-not $m -or -not$m.Timeseries) { return 0 }

    # Multi-timeseries : moyenne par série puis somme (utile si plusieurs data disks)
    $seriesAvgs = @(
        foreach ($ts in$m.Timeseries) {
            ($ts.Data | Where-Object { $null -ne$_.Average } | Measure-Object -Property Average -Average).Average
        }
    ) | Where-Object { $null -ne$_ }

    if (-not $seriesAvgs -or$seriesAvgs.Count -eq 0) { return 0 }

    $totalBytesPerSec = ($seriesAvgs | Measure-Object -Sum).Sum
    
    # Conversion de Bytes/sec en Mo/s (1 MB = 1 048 576 octets) arrondi à 2 décimales
    $totalMBps =$totalBytesPerSec / 1MB
    return [Math]::Round($totalMBps, 2)
}

$allResults = [System.Collections.Generic.List[object]]::new()

foreach ($subId in$SubscriptionIds) {
    try {
        # Changer le contexte de subscription
        Set-AzContext -Subscription $subId -ErrorAction Stop | Out-Null

        $ctx = Get-AzContext
        $subName   =$ctx.Subscription.Name
        $subRealId =$ctx.Subscription.Id

        Write-Host "==== Subscription : $subName ($subRealId) ====" -ForegroundColor Cyan

        $vms = Get-AzVM -ErrorAction Stop | Where-Object { $_.Name -match$NamePattern }
        Write-Host "VMs trouvées (pattern '$NamePattern') : $($vms.Count)" -ForegroundColor Green

        foreach ($vm in$vms) {
            Write-Host "Extraction des métriques pour la VM : $($vm.Name)..."

            $osAvg24h   = Get-AvgMetricTotalMBps -ResourceId$vm.Id -MetricName "OS Disk Write Bytes/sec"   -StartTime $start24h -EndTime $endDate -MetricNamespace$MetricNamespace
            $osAvg48h   = Get-AvgMetricTotalMBps -ResourceId$vm.Id -MetricName "OS Disk Write Bytes/sec"   -StartTime $start48h -EndTime $endDate -MetricNamespace$MetricNamespace
            $osAvg7d    = Get-AvgMetricTotalMBps -ResourceId$vm.Id -MetricName "OS Disk Write Bytes/sec"   -StartTime $start7d  -EndTime $endDate -MetricNamespace$MetricNamespace

            $dataAvg24h = Get-AvgMetricTotalMBps -ResourceId$vm.Id -MetricName "Data Disk Write Bytes/sec" -StartTime $start24h -EndTime $endDate -MetricNamespace$MetricNamespace
            $dataAvg48h = Get-AvgMetricTotalMBps -ResourceId$vm.Id -MetricName "Data Disk Write Bytes/sec" -StartTime $start48h -EndTime $endDate -MetricNamespace$MetricNamespace
            $dataAvg7d  = Get-AvgMetricTotalMBps -ResourceId$vm.Id -MetricName "Data Disk Write Bytes/sec" -StartTime $start7d  -EndTime $endDate -MetricNamespace$MetricNamespace

            $allResults.Add([pscustomobject]@{
                SubscriptionName        = $subName
                ResourceGroup           = $vm.ResourceGroupName
                Location                = $vm.Location
                VMName                  = $vm.Name
                "OS_Write_24h (Mo/s)"   = $osAvg24h
                "OS_Write_48h (Mo/s)"   = $osAvg48h
                "OS_Write_7d (Mo/s)"    = $osAvg7d
                "Data_Write_24h (Mo/s)" = $dataAvg24h
                "Data_Write_48h (Mo/s)" = $dataAvg48h
                "Data_Write_7d (Mo/s)"  = $dataAvg7d
            })
        }
    }
    catch {
        Write-Warning "Impossible de traiter la subscription $subId : $($_.Exception.Message)"
        continue
    }
}

# Export CSV (UTF8 BOM pour Excel)
if ($allResults.Count -gt 0) {
    $allResults \vert{} Export-Csv -Path$CsvSemicolonPath -NoTypeInformation -Delimiter ";" -Encoding utf8BOM
    $allResults \vert{} Export-Csv -Path$CsvCommaPath     -NoTypeInformation -Delimiter "," -Encoding utf8BOM
} else {
    Write-Warning "Aucune donnée récupérée, les fichiers CSV n'ont pas été générés."
}

Write-Host "Terminé !" -ForegroundColor Green
Write-Host "CSV (;) : $CsvSemicolonPath"
Write-Host "CSV (,) : $CsvCommaPath"
Write-Host "Lignes exportées : $($allResults.Count)"
